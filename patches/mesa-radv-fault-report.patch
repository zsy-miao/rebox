+/* rebox: entries of a BO log sorted by VA, then in log order. */
+struct radv_amdgpu_bo_log_ref {
+   const struct radv_amdgpu_winsys_bo_log *log;
+   uint64_t order;
+};
+
+static int
+radv_amdgpu_bo_log_ref_compare(const void *a, const void *b)
+{
+   const struct radv_amdgpu_bo_log_ref *x = a, *y = b;
+   if (x->log->va != y->log->va)
+      return x->log->va < y->log->va ? -1 : 1;
+   return x->order < y->order ? -1 : x->order > y->order ? 1 : 0;
+}
+
+static void
+radv_amdgpu_print_bo_log_entry(const struct radv_amdgpu_winsys_bo_log *bo_log, FILE *file)
+{
+   if (bo_log->virtual_mapping) {
+      fprintf(file, "  timestamp=%llu, VA=%.16llx-%.16llx, mapped_to=%.16llx\n", (long long)bo_log->timestamp,
+              (long long)radv_amdgpu_canonicalize_va(bo_log->va),
+              (long long)radv_amdgpu_canonicalize_va(bo_log->va + bo_log->size),
+              (long long)radv_amdgpu_canonicalize_va(bo_log->mapped_va));
+   } else {
+      fprintf(file, "  timestamp=%llu, VA=%.16llx-%.16llx, destroyed=%d, is_virtual=%d\n", (long long)bo_log->timestamp,
+              (long long)radv_amdgpu_canonicalize_va(bo_log->va),
+              (long long)radv_amdgpu_canonicalize_va(bo_log->va + bo_log->size), bo_log->destroyed,
+              bo_log->is_virtual);
+   }
+}
+
+/* rebox: what the BO history says about one address (a VM fault's): every creation, destruction
+ * and sparse binding that covered it, and the live BOs ending at or below it and starting above it,
+ * so a read past a BO's end or into a freed one shows as such. */
+static void
+radv_amdgpu_dump_bo_log_va(struct radeon_winsys *_ws, uint64_t va, FILE *file)
+{
+   struct radv_amdgpu_winsys *ws = radv_amdgpu_winsys(_ws);
+   struct radv_amdgpu_winsys_bo_log *bo_log;
+   struct radv_amdgpu_bo_log_ref *refs = NULL;
+   uint64_t count = 0, n = 0, covering = 0;
+   const struct radv_amdgpu_winsys_bo_log *below = NULL, *above = NULL;
+
+   if (!ws->debug_log_bos) {
+      fprintf(file, "No BO history (RADV_DEBUG=faultreport or hang keeps it).\n");
+      return;
+   }
+
+   va &= (1ull << 48) - 1;
+
+   u_rwlock_rdlock(&ws->log_bo_list_lock);
+   fprintf(file, "BO history entries covering 0x%.16llx:\n", (long long)va);
+   LIST_FOR_EACH_ENTRY (bo_log, &ws->log_bo_list, list) {
+      count++;
+      if (va >= bo_log->va && va - bo_log->va < bo_log->size) {
+         radv_amdgpu_print_bo_log_entry(bo_log, file);
+         covering++;
+      }
+   }
+   if (!covering)
+      fprintf(file, "  none: no BO this device made ever held that address.\n");
+
+   refs = count ? malloc(count * sizeof(*refs)) : NULL;
+   if (refs) {
+      LIST_FOR_EACH_ENTRY (bo_log, &ws->log_bo_list, list) {
+         if (bo_log->virtual_mapping)
+            continue;
+         refs[n].log = bo_log;
+         refs[n].order = n;
+         n++;
+      }
+   }
+   u_rwlock_rdunlock(&ws->log_bo_list_lock);
+
+   if (!refs) {
+      fprintf(file, "%s\n", count ? "Out of memory sorting the BO history." : "The BO history is empty.");
+      return;
+   }
+
+   /* A VA's last entry says whether a BO lives there now. Entries are never freed while the
+    * device lives, so the pointers stay valid outside the lock. */
+   qsort(refs, n, sizeof(*refs), radv_amdgpu_bo_log_ref_compare);
+   uint64_t live = 0;
+   for (uint64_t i = 0; i < n; i++) {
+      if (i + 1 < n && refs[i + 1].log->va == refs[i].log->va)
+         continue;
+      const struct radv_amdgpu_winsys_bo_log *last = refs[i].log;
+      if (last->destroyed)
+         continue;
+      live++;
+      if (last->va + last->size <= va) {
+         if (!below || last->va + last->size > below->va + below->size)
+            below = last;
+      } else if (last->va > va) {
+         if (!above || last->va < above->va)
+            above = last;
+      }
+   }
+   free(refs);
+
+   fprintf(file, "Live BOs: %llu (of %llu entries). Nearest below 0x%.16llx:\n", (long long)live, (long long)count,
+           (long long)va);
+   if (below) {
+      radv_amdgpu_print_bo_log_entry(below, file);
+      fprintf(file, "  (ends 0x%llx bytes before it)\n", (long long)(va - (below->va + below->size)));
+   } else {
+      fprintf(file, "  none\n");
+   }
+   fprintf(file, "Nearest above:\n");
+   if (above) {
+      radv_amdgpu_print_bo_log_entry(above, file);
+      fprintf(file, "  (starts 0x%llx bytes after it)\n", (long long)(above->va - va));
+   } else {
+      fprintf(file, "  none\n");
+   }
+}
