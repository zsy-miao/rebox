+/* rebox: RADV_DEBUG=faultreport. Without hang mode's waits (idle after every draw and submission,
+ * one command buffer per submission), it keeps the BO history and address binding reports, records
+ * the pipeline each queue type last bound (one WRITE_DATA per pipeline bind), and when a submission
+ * finds the device lost after a GPUVM fault, writes a report to $RADV_DUMP_DIR (else $HOME). */
+ALWAYS_INLINE static bool
+radv_device_fault_report_enabled(const struct radv_device *device)
+{
+   const struct radv_physical_device *pdev = radv_device_physical(device);
+   const struct radv_instance *instance = radv_physical_device_instance(pdev);
+
+   return RADV_DEBUG(instance, FAULT_REPORT) && !RADV_DEBUG(instance, HANG);
+}
+
+/* The bound pipeline is recorded in the trace buffer (hang mode or faultreport). */
+ALWAYS_INLINE static bool
+radv_device_pipeline_trace_enabled(const struct radv_device *device)
+{
+   const struct radv_physical_device *pdev = radv_device_physical(device);
+   const struct radv_instance *instance = radv_physical_device_instance(pdev);
+
+   return RADV_DEBUG(instance, HANG) || RADV_DEBUG(instance, FAULT_REPORT);
+}
+
+void radv_fault_report_pipeline_created(struct radv_device *device, struct radv_pipeline *pipeline);
+void radv_fault_report_pipeline_destroyed(struct radv_device *device, struct radv_pipeline *pipeline);
+void radv_write_fault_report(struct radv_queue *queue);
+
 struct radv_trace_data {
