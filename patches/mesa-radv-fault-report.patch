+/* rebox: RADV_DEBUG=faultreport (radv_debug_hang.h). */
+void
+radv_fault_report_pipeline_created(struct radv_device *device, struct radv_pipeline *pipeline)
+{
+   if (!device->fault_report_pipelines)
+      return;
+   simple_mtx_lock(&device->fault_report_mtx);
+   _mesa_set_add(device->fault_report_pipelines, pipeline);
+   simple_mtx_unlock(&device->fault_report_mtx);
+}
+
+void
+radv_fault_report_pipeline_destroyed(struct radv_device *device, struct radv_pipeline *pipeline)
+{
+   if (!device->fault_report_pipelines)
+      return;
+   simple_mtx_lock(&device->fault_report_mtx);
+   _mesa_set_remove_key(device->fault_report_pipelines, pipeline);
+   simple_mtx_unlock(&device->fault_report_mtx);
+}
+
+static void
+radv_fault_report_shader(const struct radv_shader *shader, mesa_shader_stage stage, const struct radv_pipeline *pipeline,
+                         const char *dump_dir, FILE *f)
+{
+   char hash[BLAKE3_HEX_LEN];
+
+   if (!shader)
+      return;
+
+   _mesa_blake3_format(hash, shader->hash);
+   fprintf(f, "  %s: code at 0x%" PRIx64 "-0x%" PRIx64 " (%u bytes, %u executable), wave%u, %u SGPRs, %u VGPRs,"
+              " scratch %u bytes/lane, blake3 %s\n",
+           radv_get_shader_name(&shader->info, stage), shader->va, shader->va + shader->code_size, shader->code_size,
+           shader->exec_size, shader->info.wave_size, shader->config.num_sgprs, shader->config.num_vgprs,
+           shader->config.scratch_bytes_per_wave / MAX2(shader->info.wave_size, 1), hash);
+
+   const struct radv_userdata_locations *locs = &shader->info.user_sgprs_locs;
+   fprintf(f, "    user SGPRs:");
+   for (unsigned i = 0; i < MAX_SETS; i++)
+      if (locs->descriptor_sets[i].sgpr_idx != -1)
+         fprintf(f, " set%u=s%d", i, locs->descriptor_sets[i].sgpr_idx);
+   for (unsigned i = 0; i < RADV_MAX_HEAPS; i++)
+      if (locs->descriptor_heaps[i].sgpr_idx != -1)
+         fprintf(f, " heap%u=s%d", i, locs->descriptor_heaps[i].sgpr_idx);
+   for (unsigned i = 0; i < AC_UD_MAX_UD; i++)
+      if (locs->shader_data[i].sgpr_idx != -1)
+         fprintf(f, " ud%u=s%d(%u)", i, locs->shader_data[i].sgpr_idx, locs->shader_data[i].num_sgprs);
+   fprintf(f, "\n");
+
+   if (shader->code && dump_dir) {
+      char path[512];
+      snprintf(path, sizeof(path), "%s/pipeline_%" PRIx64 "_%s.bin", dump_dir, (uint64_t)(uintptr_t)pipeline,
+               mesa_shader_stage_name(stage));
+      FILE *code = fopen(path, "wb");
+      if (code) {
+         fwrite(shader->code, shader->code_size, 1, code);
+         fclose(code);
+         fprintf(f, "    code: %s\n", path);
+      }
+   }
+
+   if (shader->dbg.disasm_string)
+      fprintf(f, "    DISASM:\n%s\n", shader->dbg.disasm_string);
+}
+
+static void
+radv_fault_report_pipeline(struct radv_device *device, const char *ring_name, uint64_t saved, const char *dump_dir,
+                           FILE *f)
+{
+   struct radv_pipeline *pipeline = (struct radv_pipeline *)(uintptr_t)saved;
+
+   fprintf(f, "Last pipeline the %s ring's command processor bound: ", ring_name);
+   if (!pipeline) {
+      fprintf(f, "none\n\n");
+      return;
+   }
+   /* The trace buffer is written as the command processor runs ahead of the shaders, without
+    * waits: this is the pipeline of the last bind it reached, at or after the faulting one. */
+   fprintf(f, "VkPipeline 0x%" PRIx64 "\n", (uint64_t)(uintptr_t)pipeline);
+
+   simple_mtx_lock(&device->fault_report_mtx);
+   if (!_mesa_set_search(device->fault_report_pipelines, pipeline)) {
+      simple_mtx_unlock(&device->fault_report_mtx);
+      fprintf(f, "  (destroyed since)\n\n");
+      return;
+   }
+
+   fprintf(f, "  hash %016" PRIx64 ", type %d, name %s\n", pipeline->pipeline_hash, pipeline->type,
+           pipeline->base.object_name ? pipeline->base.object_name : "<unnamed>");
+
+   for (unsigned s = 0; s < MESA_VULKAN_SHADER_STAGES; s++)
+      radv_fault_report_shader(pipeline->shaders[s], s, pipeline, dump_dir, f);
+   if (pipeline->type == RADV_PIPELINE_RAY_TRACING) {
+      struct radv_ray_tracing_pipeline *rt_pipeline = radv_pipeline_to_ray_tracing(pipeline);
+      radv_fault_report_shader(rt_pipeline->prolog, MESA_SHADER_COMPUTE, pipeline, dump_dir, f);
+   }
+   simple_mtx_unlock(&device->fault_report_mtx);
+   fprintf(f, "\n");
+}
+
+/* Called once a submission found the device lost (radv_queue_set_lost): writes what is known
+ * without hang mode's waits to $RADV_DUMP_DIR/radv_dumps_<pid>_<time>/ (else $HOME), once per
+ * device. fault.log first: the GPUVM fault, what the BO history and address binding reports say
+ * of its address, and the pipelines last bound. */
+void
+radv_write_fault_report(struct radv_queue *queue)
+{
+#ifndef _WIN32
+   struct radv_device *device = radv_queue_device(queue);
+   const struct radv_physical_device *pdev = radv_device_physical(device);
+   struct radv_winsys_gpuvm_fault_info fault_info = {0};
+   char path[512];
+   FILE *f;
+
+   if (!device->fault_report_pipelines)
+      return;
+
+   simple_mtx_lock(&device->fault_report_mtx);
+   bool written = device->fault_report_written;
+   device->fault_report_written = true;
+   simple_mtx_unlock(&device->fault_report_mtx);
+   if (written)
+      return;
+
+   bool vm_fault_occurred = radv_vm_fault_occurred(device, &fault_info);
+   char *dump_dir = radv_create_dump_dir();
+   fprintf(stderr, "radv: device lost; fault report in '%s'.\n", dump_dir);
+
+   snprintf(path, sizeof(path), "%s/fault.log", dump_dir);
+   if ((f = fopen(path, "w"))) {
+      struct timespec real;
+      clock_gettime(CLOCK_REALTIME, &real);
+      fprintf(f, "Device lost on the %s ring. Now: monotonic %" PRIu64 " ns (the timestamps below), wall %lld.%09ld\n\n",
+              ac_get_ip_type_string(&pdev->info, radv_queue_ring(queue)), (uint64_t)os_time_get_nano(),
+              (long long)real.tv_sec, real.tv_nsec);
+      if (vm_fault_occurred) {
+         radv_dump_vm_fault(device, &fault_info, f);
+         fprintf(f, "\n");
+         if (device->ws->dump_bo_log_va)
+            device->ws->dump_bo_log_va(device->ws, fault_info.addr, f);
+      } else {
+         fprintf(f, "No GPUVM fault reported.\n");
+      }
+      fprintf(f, "\n");
+      radv_fault_report_pipeline(device, "GFX", device->trace_data->gfx_ring_pipeline, dump_dir, f);
+      radv_fault_report_pipeline(device, "COMPUTE", device->trace_data->comp_ring_pipeline, dump_dir, f);
+      fclose(f);
+   }
+
+   snprintf(path, sizeof(path), "%s/bo_history.log", dump_dir);
+   if ((f = fopen(path, "w"))) {
+      device->ws->dump_bo_log(device->ws, f);
+      fclose(f);
+   }
+   snprintf(path, sizeof(path), "%s/addr_binding_report.log", dump_dir);
+   if ((f = fopen(path, "w"))) {
+      if (device->addr_binding_tracker)
+         radv_dump_address_binding_reports(device, f);
+      fclose(f);
+   }
+   snprintf(path, sizeof(path), "%s/app_info.log", dump_dir);
+   if ((f = fopen(path, "w"))) {
+      radv_dump_app_info(device, f);
+      fclose(f);
+   }
+   snprintf(path, sizeof(path), "%s/gpu_info.log", dump_dir);
+   if ((f = fopen(path, "w"))) {
+      radv_dump_device_name(device, f);
+      ac_print_gpu_info(f, &pdev->info, device->ws->get_fd(device->ws));
+      fclose(f);
+   }
+   snprintf(path, sizeof(path), "%s/dmesg.log", dump_dir);
+   if ((f = fopen(path, "w"))) {
+      radv_dump_dmesg(f);
+      fclose(f);
+   }
+
+   free(dump_dir);
+   fprintf(stderr, "radv: fault report written.\n");
+#endif
+}
