+/* rebox (patch 0030): whether d3d12_xs made this draw's or dispatch's console compiles wait (its
+ * ReboxConsoleMustDraw: one of a program's first calls, or a full-screen pass's, which the title
+ * may make only once, as with the lighting tables a world bakes at its first frame). Its pipeline
+ * is then made here, not by the workers, so the call isn't skipped while it is built. Asked once
+ * per lookup, which clears it. */
+static bool vkd3d_rebox_must_draw(void)
+{
+    typedef BOOL (WINAPI *PFN_must_draw)(void);
+    static PFN_must_draw fn;
+    static bool resolved;
+    vkd3d_module_t module;
+
+    if (!resolved)
+    {
+        if ((module = vkd3d_dlopen("d3d12_xs.dll")))
+            fn = (PFN_must_draw)vkd3d_dlsym(module, "ReboxConsoleMustDraw");
+        resolved = true;
+    }
+    return fn && fn();
+}
