+/* rebox (patch 0033): whether d3d12_xs wants the buffer heap being made to be memory of its own
+ * (ReboxHeapWhole). Title memory it makes GPU memory in place is a heap whose allocation the
+ * gpuva_identity layer puts at the title's address; it can't do that to a chunk the heap is only a
+ * piece of. Without this such heaps had to be 2 MiB or more, and title memory between GPU memory
+ * less than 2 MiB apart stayed out of GPU memory. */
+static bool vkd3d_rebox_heap_whole(uint64_t size)
+{
+    typedef int (*PFN_heap_whole)(uint64_t size);
+    static PFN_heap_whole fn;
+    static bool resolved;
+    vkd3d_module_t module;
+
+    if (!resolved)
+    {
+        if ((module = vkd3d_dlopen("d3d12_xs.dll")))
+            fn = (PFN_heap_whole)vkd3d_dlsym(module, "ReboxHeapWhole");
+        resolved = true;
+    }
+    return fn && fn(size);
+}
