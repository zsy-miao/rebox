+/* rebox (patch 0031): each console pipeline's VkPipeline handle with the keys d3d12_xs logs its
+ * compiles under, so a driver fault report naming the pipeline it ran (RADV_DEBUG=faultreport,
+ * patches/mesa-radv-fault-report.patch: RADV's handle is its pipeline's address) names the console
+ * shaders. REBOX_PIPELINE_HANDLES=1, or on with RADV_DEBUG's faultreport. */
+static bool rebox_pipeline_handles(void)
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        char value[256];
+        on = (vkd3d_get_env_var("REBOX_PIPELINE_HANDLES", value, sizeof(value)) && !strcmp(value, "1"))
+                || (vkd3d_get_env_var("RADV_DEBUG", value, sizeof(value)) && strstr(value, "faultreport"));
+    }
+    return on;
+}
+
+static void rebox_log_pipeline_handle(const char *kind, VkPipeline vk_pipeline, uint64_t key0, uint64_t key1)
+{
+    if (vk_pipeline && rebox_pipeline_handles())
+        ERR("rebox: console %s pipeline 0x%"PRIx64": keys %016"PRIx64" %016"PRIx64".\n", kind,
+                (uint64_t)vk_pipeline, key0, key1);
+}
