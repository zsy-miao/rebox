+        // hundreds of selections per web, a web per image access).
         auto& instructions = block->Instructions();
+        auto [positions, fresh] = web.positions.try_emplace(block);
+        if (fresh) {
+            std::size_t index = 0;
+            for (auto it = instructions.begin(); it != instructions.end(); ++it) {
+                positions->second.insert_or_assign(*it, std::make_pair(index++, it));
+            }
+        }
         auto latest = instructions.end();
