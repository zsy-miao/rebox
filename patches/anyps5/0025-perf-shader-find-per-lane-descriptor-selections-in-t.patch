-            if (std::ranges::find(tuple, *it) != tuple.end()) {
-                latest = it;
+        std::size_t latestIndex = 0;
+        for (const IrValue* value : tuple) {
+            const auto found = positions->second.find(value);
+            if (found != positions->second.end() && (latest == instructions.end() || found->second.first > latestIndex)) {
+                latestIndex = found->second.first;
+                latest = found->second.second;
             }
         }
         if (latest == instructions.end()) {
             return GiveUp(web, "a per-lane descriptor selection is not in its block");
         }
-        IrValue* before = std::next(latest) == instructions.end() ? nullptr : *std::next(latest);
+        const auto before = std::next(latest);
         IrValue* leftSelector = WebSelector(std::move(left), web, position);
         if (leftSelector == nullptr) {
             return nullptr;
@@ -1844,12 +1861,11 @@ private:
