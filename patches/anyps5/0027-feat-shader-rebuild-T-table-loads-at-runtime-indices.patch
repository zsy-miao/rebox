                 for (std::size_t word = 0; word < selected.size(); word++) {
@@ -1594,6 +1652,8 @@
         static constexpr std::uint32_t foldedArm = 0xffffffffu;
         std::string failure;
         bool foldedValue = false;
+        // Each split handle's dwords in a tuple: first and count.
