+    // A scalar read through an address at an offset that is not made of registers only: a table
+    // slot picked at runtime.
+    bool KeyedAddressRead(IrValue* value) const {
+        value = value->Resolve();
+        std::uint32_t memoryIndex = 0u;
+        return value->Opcode() == IrOpcode::LoadAddressU32 && value->ArgumentCount() > 1u && ScalarAddressMemory(*value, memoryIndex) != nullptr &&
+            !RegisterOnlyOffset(value->Argument(1), phiSearchDepth);
+    }
+
+    // A descriptor's dwords, rebuilt on one path, that a table column can read if any is a table
+    // slot picked at runtime: then all are, consecutive words of one slot (an image's last four
+    // may be zero instead). Other mixes are left to the descriptor web's folded path.
+    bool KeyedDescriptorConsistent(std::span<IrValue* const> words) const {
+        if (std::ranges::none_of(words, [&](IrValue* word) { return KeyedAddressRead(word); })) return true;
+        const IrValue* first = words.front()->Resolve();
+        std::uint32_t memoryIndex = 0u;
+        if (!KeyedAddressRead(words.front())) return false;
+        const auto base = ScalarAddressMemory(*first, memoryIndex)->offset;
+        for (std::size_t dword = 0; dword < words.size(); dword++) {
+            IrValue* word = words[dword]->Resolve();
+            std::uint32_t immediate = 0u;
+            if (dword >= 4u && immediateU32(word, immediate) && immediate == 0u) continue;
+            const MemoryInfo* memory = KeyedAddressRead(word) ? ScalarAddressMemory(*word, memoryIndex) : nullptr;
+            if (memory == nullptr || memory->offset != base + static_cast<std::uint32_t>(dword * sizeof(std::uint32_t)) ||
+                !EquivalentValue(m_program.Resources(), first->Argument(0), word->Argument(0)) || !EquivalentValue(m_program.Resources(), first->Argument(1), word->Argument(1))) return false;
+        }
+        return true;
+    }
+
+    // An offset made of immediates, user data, uniform operations and raw scalar reads already done
+    // before position (a table index read from constants, for a T# loaded from a table in memory
+    // on one path of a descriptor web): the read is reused, not done again.
+    bool AvailableOffset(IrValue* value, const IrValue& position, std::uint32_t depth) const {
+        value = value->Resolve();
+        if (value->HasImmediate()) return true;
+        if (Detail::IsRawRead(m_program.Resources(), *value) || value->IsPhi()) return AvailableBefore(*value, position);
+        if (value->Opcode() == IrOpcode::GetUserData) return value->ArgumentCount() == 1u;
+        if (value->Opcode() == IrOpcode::ReadConst && value->ArgumentCount() == 2u) {
+            return value->Argument(0)->Resolve()->Opcode() == IrOpcode::GetSrtResource && value->Argument(1)->Resolve()->HasImmediate();
+        }
+        if (depth == 0u || !Detail::IsRuntimeUniformOp(value->Opcode())) return false;
+        for (std::size_t index = 0; index < value->ArgumentCount(); index++) {
+            if (!AvailableOffset(value->Argument(index), position, depth - 1u)) return false;
+        }
+        return true;
+    }
+
     IrValue* Rematerialize(IrValue* value, IrValue& position, bool emit, std::uint32_t depth, bool pointerOperand = false) {
         value = value->Resolve();
         if (value->HasImmediate()) {
@@ -1344,14 +1391,14 @@
         const bool srtRead = op == IrOpcode::ReadConst && value->ArgumentCount() == 2u && value->Argument(0)->Resolve()->Opcode() == IrOpcode::GetSrtResource && value->Argument(1)->Resolve()->HasImmediate();
         std::uint32_t memoryIndex = 0u;
         const bool rawRead = op == IrOpcode::LoadAddressU32 && ScalarAddressMemory(*value, memoryIndex) != nullptr &&
-            RegisterOnlyOffset(value->Argument(1), phiSearchDepth);
+            (RegisterOnlyOffset(value->Argument(1), phiSearchDepth) || AvailableOffset(value->Argument(1), position, phiSearchDepth));
         const bool sourceHandle = op == IrOpcode::GetAddressResource && value->ArgumentCount() == 2u;
         if (!register_ && !argumentless && !srtRead && !rawRead && !sourceHandle && !Detail::IsRuntimeUniformOp(op)) {
             return nullptr;
         }
         std::vector<IrValue*> arguments;
         for (std::size_t index = 0; index < value->ArgumentCount(); index++) {
-            IrValue* argument = register_ ? value->Argument(index) : Rematerialize(value->Argument(index), position, emit, depth - 1u, pointerOperand || (rawRead && index == 0u));
+            IrValue* argument = register_ ? value->Argument(index) : Rematerialize(value->Argument(index), position, emit, depth - 1u, pointerOperand || rawRead);
             if (argument == nullptr) {
                 return nullptr;
             }
@@ -1472,10 +1519,16 @@
         }
         for (const IrBlock* arm : arms) {
             for (std::uint32_t slot = 0; slot < handleCount; slot++) {
+                std::vector<IrValue*> words;
                 for (std::size_t dword = 0; split[slot] && dword < handles[slot]->ArgumentCount(); dword++) {
-                    if (SubstituteEdge(handles[slot]->Argument(dword), arm, inst, false, phiSearchDepth) == nullptr) {
+                    IrValue* word = SubstituteEdge(handles[slot]->Argument(dword), arm, inst, false, phiSearchDepth);
+                    if (word == nullptr) {
                         return false;
                     }
