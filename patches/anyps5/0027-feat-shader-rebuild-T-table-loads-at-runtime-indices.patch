diff --git a/core/shader/recompiler/tests/DescriptorSelectionTests.cpp b/core/shader/recompiler/tests/DescriptorSelectionTests.cpp
--- a/core/shader/recompiler/tests/DescriptorSelectionTests.cpp
+++ b/core/shader/recompiler/tests/DescriptorSelectionTests.cpp
@@ -135,6 +135,59 @@
     Require(CountOps(words, spv::OpImageWrite) == 2u, "a store through a branch-selected T# becomes one store per T#");
 }
 
+// s[8:9] = two table indices, read at user s4 plus eight times the first lane's v0 (so not known
+// when the plan is made), s[10:11] = a path choice and a skip flag (user s4 plus 0x40), and s12 a
+// word read at an index too: s[12:19] holds no T#. Unless the skip flag is 1, s[12:19] is loaded
+// from the T# table at user s2, at the index the choice picks, on one of two paths; image_load then
+// reads through s[12:19] whichever way it came, and buffer_store writes the texel through the V#
+// in s[24:27].
+constexpr std::array<std::uint32_t, 30> TableIndexPathsShader{
+    0xbe850380u, 0x7e0c0500u, 0x8f068306u, 0xf4040202u, 0x0c000000u, 0xf4040282u, 0xfa000040u, 0xbf8cc07fu,
+    0xf4000302u, 0x10000000u, 0x8f148508u, 0x8f158509u, 0xbe830380u, 0xbf06810bu, 0xbf850007u, 0xbf06800au,
+    0xbf850003u, 0xf40c0301u, 0x28000000u, 0xbf820002u, 0xf40c0301u, 0x2a000000u, 0xbf8cc07fu, 0xf0001100u,
+    0x00030100u, 0xbf8c3f70u, 0x34040082u, 0xe0701000u, 0x80060102u, 0xbf810000u,
+};
+
+constexpr std::uint32_t IndexAddress = 0x28000000u;
+
+// Target() with 8-bit storage, which reads at runtime addresses need.
+SpirvTarget ByteTarget() {
+    static constexpr std::array<std::uint32_t, 9> capabilities{spv::CapabilityInt64, spv::CapabilityPhysicalStorageBufferAddresses, spv::CapabilityImageQuery, spv::CapabilitySampled1D,
+                                                               spv::CapabilityImage1D, spv::CapabilityStorageImageWriteWithoutFormat, spv::CapabilityGroupNonUniformBallot, spv::CapabilityGroupNonUniformVote,
+                                                               spv::CapabilityStorageBuffer8BitAccess};
+    static constexpr std::array<std::string_view, 2> extensions{"SPV_KHR_physical_storage_buffer", "SPV_KHR_8bit_storage"};
+    return {0x00402000u, 0x00010500u, 32u, BdaAbi::Version, capabilities, extensions, false, {1024, 1024, 64}, 1024, 65536, {}, {}};
+}
+
+RecompileResult CompileTableIndexPaths() {
+    static const auto entries = Table();
+    static std::array<std::byte, 64u * 1024u> output{};
+    const std::array<std::uint32_t, 18> indices{4u, 9u};
+    std::array<std::uint32_t, 28> user{};
+    user[2] = TableAddress;
+    user[4] = IndexAddress;
+    user[24] = OutputAddress;
+    user[26] = 1024u;
+    user[27] = 0xfacu | (77u << 12u);
+    const std::vector<MemoryRegion> regions{{TableAddress, std::as_bytes(std::span<const std::uint32_t>(entries))}, {IndexAddress, std::as_bytes(std::span<const std::uint32_t>(indices))}, {OutputAddress, std::span<const std::byte>(output)}};
+    const ShaderComputeStageInfo compute{{32u, 1u, 1u}, 0u, {false, false, false}, false, 1u};
+    RecompileRequest request{
+        {ShaderStage::Compute, 0x10000000u, TableIndexPathsShader, 0, {}},
+        {32u, 0, std::span<const std::uint32_t>(user), compute, std::nullopt, std::nullopt, MemoryRegionView(std::span<const MemoryRegion>(regions)), ShaderFloatMode{}},
+        ByteTarget(),
+        {0, 0, 0, 128},
+    };
+    request.useCache = false;
+    return Recompile(request);
+}
+
+void TestTableIndexPathsReadAnImageTable() {
+    const auto result = CompileTableIndexPaths();
+    ValidWords(result, "the module whose T# is loaded at an index read from memory validates");
+    Require(std::ranges::any_of(result.bindings, [](const auto& binding) { return binding.role == DescriptorRole::ImageTable; }),
+            "a T# loaded from a table at an index read from memory, on either of two paths, is read through an image table");
+}
