@@ -1550,7 +1603,12 @@
             copies.push_back(EmitBefore(inst, inst.Opcode(), inst.Type(), arguments, rawFlags));
         }
 
-        if (optional) {
+        // An arm whose T# is read from a table at a runtime index becomes a table column, whose words
